# HOU2ED App Environment Variables
# Copy this file to .env.local and fill in your actual values

# ===================================
# REQUIRED: Supabase Configuration
# ===================================
# Get these from: https://supabase.com/dashboard/project/YOUR-PROJECT/settings/api
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ===================================
# App Configuration
# ===================================
EXPO_PUBLIC_APP_SCHEME=hou2ed
EXPO_PUBLIC_APP_NAME=HOU2ED

# ===================================
# OPTIONAL: Maps Configuration
# ===================================
# Only needed if using Google Maps
# EXPO_PUBLIC_MAPS_PROVIDER=google
# EXPO_PUBLIC_MAPS_IOS_API_KEY=your-ios-key-here
# EXPO_PUBLIC_MAPS_ANDROID_API_KEY=your-android-key-here
# Mapbox Geocoding (optional, for address lookup)
# EXPO_PUBLIC_MAPBOX_TOKEN=your-mapbox-access-token

# ===================================
# OPTIONAL: Analytics & Monitoring
# ===================================
# Only needed for production
# EXPO_PUBLIC_SENTRY_DSN=https://your-sentry-dsn-here
# EXPO_PUBLIC_POSTHOG_KEY=your-posthog-key-here
